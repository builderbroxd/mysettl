# QDay Aevum Testnet (chain ID 44005). Explorer: https://explorer-test.qday.info
AEVUM_RPC_URL=https://rpc-test.qday.info

# Deployer private key (testnet only, never commit). Fund it at https://faucet.qday.info/en
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Privy (Embedded Wallets)
VITE_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Reclaim Protocol (Optional - for zkTLS proofs)
VITE_RECLAIM_APP_ID=your_reclaim_app_id
VITE_RECLAIM_APP_SECRET=your_reclaim_app_secret

# Contract addresses. Run `npm run deploy:aevum` and paste the lines it prints.
# VITE_DEMO_USDC_ADDRESS is the settlement stablecoin: SETTL USD (sUSD), mintable in Settings.
VITE_DEMO_USDC_ADDRESS=0x45D371fC414ab30bc6B88AB9B31A8c7d87691B68
